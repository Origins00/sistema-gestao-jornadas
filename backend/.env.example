# Copie este arquivo para backend/.env e altere apenas a cópia local.
# Nunca coloque senhas ou credenciais reais no arquivo versionado.

BANCO_HOST=127.0.0.1
BANCO_PORTA=3306
BANCO_USUARIO=usuario_local
BANCO_SENHA=troque_por_uma_senha_local
BANCO_NOME=gestor_jornadas

# Use desenvolvimento somente no ambiente local.
# Se a variável estiver ausente, o backend assume produção por segurança.
AMBIENTE=desenvolvimento

HOSTS_PERMITIDOS=127.0.0.1,localhost
ORIGENS_DESENVOLVIMENTO=http://127.0.0.1:5500,http://localhost:5500,http://127.0.0.1:5501,http://localhost:5501
SESSAO_DURACAO_HORAS=168
